generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  dni            String?         @unique
  email          String?         @unique
  phone          String?         @unique
  role           String          @default("MEMBER") // ADMIN, MEMBER, MUSICIAN
  status         String          @default("ACTIVE") // ACTIVE, PENDING, REJECTED
  pin            String?         @default("1234")   // PIN o contraseña de ingreso
  avatarUrl      String?
  qr_code_hash   String          @unique
  createdAt      DateTime        @default(now())
  
  attendances       Attendance[]
  payments          PaymentRecord[]
  validatedPayments PaymentRecord[] @relation("ValidatedBy")
  feedbacks         Feedback[]
}

model Event {
  id          String   @id @default(uuid())
  title       String
  type        String   // ENSAYO, PASACALLE, REUNIÓN
  date        DateTime
  location    String
  qr_token    String   @unique
  createdAt   DateTime @default(now())
  
  attendances Attendance[]
}

model Attendance {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  timestamp DateTime @default(now())
  status    String   // PRESENT, LATE, ABSENT

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model PaymentFee {
  id          String   @id @default(uuid())
  title       String
  amount      Float
  category    String   @default("OTRO") // VESTUARIO, CUOTA_MENSUAL, EVENTO, OTRO
  description String?
  stock       Int?     @default(100)
  gender      String?  @default("UNISEX") // VARON, MUJER, UNISEX
  availableSizes String? @default("S,M,L,XL")
  createdAt   DateTime @default(now())

  payments PaymentRecord[]
}

model PaymentRecord {
  id            String    @id @default(uuid())
  userId        String
  feeId         String?
  amount        Float
  status        String    @default("PENDING") // PENDING, VALIDATING, PAID, REJECTED
  receiptUrl    String?
  validatedById String?
  validatedAt   DateTime?
  itemsDetail   String?   // Detalle del producto (ej: "Camisa Bordada Talla L")
  deliveryStatus String?  @default("PENDIENTE") // PENDIENTE, ENTREGADO
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fee         PaymentFee? @relation(fields: [feeId], references: [id], onDelete: SetNull)
  validatedBy User?       @relation("ValidatedBy", fields: [validatedById], references: [id])
}

model Feedback {
  id          String   @id @default(uuid())
  userId      String?
  type        String   // SUGERENCIA, RECLAMO, CONSULTA
  message     String
  isAnonymous Boolean  @default(false)
  userName    String?
  userRole    String?
  status      String   @default("PENDIENTE") // PENDIENTE, REVISADO
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Song {
  id        String   @id @default(uuid())
  title     String
  lyrics    String
  audioUrl  String?
  createdAt DateTime @default(now())
}
