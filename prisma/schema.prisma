generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(uuid())
  name           String
  dni            String?         @unique
  email          String?         @unique
  phone          String?         @unique
  role           String          @default("MEMBER") // ADMIN, MEMBER, MUSICIAN
  status         String          @default("ACTIVE") // ACTIVE, PENDING, REJECTED
  pin            String?         @default("1234")   // PIN o contraseña de ingreso
  avatarUrl      String?
  qr_code_hash   String          @unique
  createdAt      DateTime        @default(now())
  
  attendances       Attendance[]
  payments          PaymentRecord[]
  validatedPayments PaymentRecord[] @relation("ValidatedBy")
  announcements     Announcement[]
}

model Event {
  id          String       @id @default(uuid())
  title       String
  date        DateTime
  location    String
  type        String       @default("ENSAYO") // ENSAYO, PRESENTACION, REUNION
  description String?
  createdAt   DateTime     @default(now())

  attendances Attendance[]
}

model Attendance {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  event       Event    @relation(fields: [eventId], references: [id])
  eventId     String
  status      String   @default("PRESENT") // PRESENT, LATE, ABSENT
  timestamp   DateTime @default(now())
  markedBy    String?  // ID del admin que lo marcó manualmente, null si fue por QR

  @@unique([userId, eventId])
}

model PaymentFee {
  id           String          @id @default(uuid())
  title        String
  amount       Float
  dueDate      DateTime?
  category     String          @default("VESTUARIO") // VESTUARIO, CUOTA, ACCESORIOS
  targetGender String          @default("ALL")       // ALL, VARON, MUJER
  sizes        String?         @default("S, M, L, XL") // Tallas disponibles (ej. "S, M, L, XL", "Única")
  stock        Int             @default(50)            // Stock o unidades disponibles
  imageUrl     String?         // Foto de la prenda en catálogo
  createdAt    DateTime        @default(now())

  records      PaymentRecord[]
}

model PaymentRecord {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  fee           PaymentFee? @relation(fields: [feeId], references: [id])
  feeId         String?
  itemsDetail   String?     // Detalle de prendas/productos solicitados con talla (ej. "Camisa Varón - Talla: L")
  totalAmount   Float       @default(0.0) // Monto total a pagar
  status        String      @default("VALIDATING") // VALIDATING, PAID, REJECTED
  proofUrl      String?     // URL de la captura de pantalla Yape/Plin
  validatedBy   User?       @relation("ValidatedBy", fields: [validatorId], references: [id])
  validatorId   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Song {
  id        String   @id @default(uuid())
  title     String
  lyrics    String
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("GENERAL") // URGENTE, ENSAYO, VESTUARIO, GENERAL
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Feedback {
  id          String   @id @default(uuid())
  type        String   @default("SUGERENCIA") // SUGERENCIA, RECLAMO, CONSULTA
  message     String
  isAnonymous Boolean  @default(false)
  userName    String?  // Nombre del socio si no es anónimo
  userRole    String?  // MEMBER, MUSICIAN
  status      String   @default("PENDIENTE") // PENDIENTE, REVISADO
  createdAt   DateTime @default(now())
}
